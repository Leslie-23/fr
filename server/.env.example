PORT=4000
MONGODB_URI=mongodb://localhost:27017/ledger
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Google sign-in (optional — leave unset to disable). This must be the OAuth 2.0
# "Web application" client ID from Google Cloud Console, not the iOS/Android one:
# Google issues ID tokens against the web client regardless of which platform signed in.
GOOGLE_WEB_CLIENT_ID=
